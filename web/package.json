{
  "name": "laskin",
  "version": "4.0.0",
  "description": "Reverse Polish notation calculator / programming language (WebAssembly)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./laskin.wasm": "./laskin.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "laskin.js",
    "laskin.wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "laskin",
    "rpn",
    "calculator",
    "webassembly",
    "wasm",
    "forth"
  ],
  "author": "Rauli Laine <rauli.laine@iki.fi>",
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/RauliL/laskin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RauliL/laskin.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/RauliL/laskin/issues"
  },
  "scripts": {
    "build": "zx build.mjs",
    "build:deps": "zx build.mjs --deps-only",
    "clean": "rimraf laskin.js laskin.wasm",
    "test": "node --test test/**/*.test.js",
    "style:check": "prettier --check .",
    "style:fix": "prettier --write .",
    "prebuild": "$npm_execpath run clean",
    "pretest": "$npm_execpath run build",
    "prepack": "$npm_execpath run build",
    "prepublishOnly": "node -e \"const fs=require('fs'); if(!fs.existsSync('laskin.wasm')) { console.error('Missing laskin.wasm — run npm run build first'); process.exit(1); }\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "zx": "^8.8.5"
  }
}

{
  "name": "laskin",
  "version": "3.1.0",
  "description": "Reverse Polish notation calculator / programming language (WebAssembly)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./laskin.wasm": "./laskin.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "laskin.js",
    "laskin.wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "laskin",
    "rpn",
    "calculator",
    "webassembly",
    "wasm",
    "forth"
  ],
  "author": "Rauli Laine <rauli.laine@iki.fi>",
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/RauliL/laskin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RauliL/laskin.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/RauliL/laskin/issues"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "node -e \"const fs=require('fs'); if(!fs.existsSync('laskin.wasm')) { console.error('Missing laskin.wasm — publish from web/dist after ./scripts/build-wasm.sh'); process.exit(1); }\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
